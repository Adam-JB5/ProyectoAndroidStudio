<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/negro_fondo">

    <!-- TOP BAR -->
    <include
        android:id="@+id/topBar"
        layout="@layout/top_bar"/>

    <!-- FILTROS HORIZONTALES (Botones estáticos por ahora) -->
    <HorizontalScrollView
        android:id="@+id/filtrosScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:padding="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/filtrosLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <!-- Se llena dinámicamente desde PartidosActivity -->
        </LinearLayout>
    </HorizontalScrollView>

    <!-- CONTENIDO SCROLLABLE -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/filtrosScroll"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="32dp"
        android:visibility="gone"/>
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/filtrosScroll"
        android:layout_above="@id/bottomBar"
        android:padding="8dp"
        android:background="@color/negro_fondo">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- SECCIÓN: EQUIPOS SEGUIDOS -->
            <TextView
                android:id="@+id/labelSeguidos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Equipos seguidos"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutEquiposSeguidos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="4dp">
                </LinearLayout>

            </HorizontalScrollView>

            <!-- SECCIÓN: TODOS LOS PARTIDOS -->
            <TextView
                android:id="@+id/labelTodos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Todos los partidos"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp" />

            <!-- CONTENEDOR DINÁMICO (Vaciado para el backend) -->
            <LinearLayout
                android:id="@+id/layoutTodosPartidos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- Se llenará con agregarPartidoAVista() -->
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAV -->
    <include
        android:id="@+id/bottomBar"
        layout="@layout/bottom_bar"/>

    <!-- Menus y overlay (mantenemos funcionalidad de TopBarHelper) -->
    <include
        layout="@layout/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <include
        layout="@layout/menu_menu"
        android:layout_width="280dp"
        android:layout_height="match_parent"/>

    <include
        layout="@layout/menu_user"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"/>

</RelativeLayout>